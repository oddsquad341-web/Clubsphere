# SERVER-ONLY secrets. Add these in Vercel → Project → Settings → Environment Variables. NEVER prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
# Batch 7 – SMS via MSG91 (Supabase Auth "Send SMS" hook)
SEND_SMS_HOOK_SECRET=v1,whsec_...
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Batch 8 – Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Batch 9 – Web push
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=you@example.com
PUSH_WEBHOOK_SECRET=
